<view class="page">
  <view class="sub">按反转 / 持续 / 中性分类 · 依据尼森《日本蜡烛图技术》</view>
  <view class="search">
    <input placeholder="搜索形态名称或别名" value="{{keyword}}" bindinput="onSearch" />
  </view>
  <scroll-view class="tabs" scroll-x>
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{tab === item.id ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTab"
    >{{item.title}}</view>
  </scroll-view>

  <view wx:if="{{tab === 'principles'}}">
    <view class="card lesson" wx:for="{{lessons}}" wx:key="id">
      <view class="ch">{{item.chapter}}</view>
      <view class="name">{{item.title}}</view>
      <view class="sub">{{item.summary}}</view>
    </view>
  </view>
  <view wx:else>
    <view class="card pat" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="row between">
        <view class="name">{{item.name}}</view>
        <text class="tag tag-{{item.bias}}">{{item.biasText}}</text>
      </view>
      <view class="muted">{{item.categoryText}} · {{item.bars}} 根</view>
      <view class="sub">{{item.psychology}}</view>
    </view>
    <view wx:if="{{!list.length}}" class="muted empty">没有匹配的形态</view>
  </view>
</view>
