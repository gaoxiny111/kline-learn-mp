.hero .muted { margin-bottom: 8rpx; }
.stats { display: flex; gap: 12rpx; margin-bottom: 8rpx; }
.stat { flex: 1; text-align: center; padding: 20rpx 8rpx; }
.num { font-size: 32rpx; font-weight: 700; color: #1d5fd1; }
.rec-title { display: flex; align-items: center; gap: 12rpx; margin: 8rpx 0; }
.rec .name { font-size: 34rpx; font-weight: 700; }
.actions { display: flex; flex-direction: column; gap: 4rpx; }
.action .name { font-size: 32rpx; font-weight: 700; }
