<view class="page">
  <view class="search">
    <input placeholder="输入代码或名称" value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="search" />
  </view>
  <view class="btn" bindtap="search">搜索</view>
  <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="add">
    <view class="name">{{item.name}}</view>
    <view class="muted">{{item.id}} · {{item.market}}</view>
  </view>
</view>
